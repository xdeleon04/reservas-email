
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isStaff() {
      return request.auth.uid != null && request.auth.token.role in ['admin', 'receptionist', 'waiter'];
    }

    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isReceptionist() {
      return request.auth.token.role == 'receptionist';
    }
    
    function isWaiter() {
      return request.auth.token.role == 'waiter';
    }

    match /reservations/{reservationId} {
      // Allow anonymous users to create their own reservation and tag it with their UID.
      allow create: if request.auth.uid != null && request.resource.data.userId == request.auth.uid;
      
      // Allow staff to get any reservation.
      // Allow an authenticated user (including anonymous) to get their own reservation.
      allow get: if isStaff() || (request.auth.uid != null && request.auth.uid == resource.data.userId);

      // Allow staff to list all reservations.
      // Allow an authenticated user (including anonymous) to query for their own reservations.
      allow list: if isStaff() || (request.auth.uid != null && request.query.where.userId == request.auth.uid);
      
      // Allow admins and receptionists to update/delete any reservation.
      allow update, delete: if isAdmin() || isReceptionist();
    }

    match /tables/{tableId} {
      // Any staff can read the tables list.
      allow read: if isStaff();

      // Only admins can create/delete tables.
      allow create, delete: if isAdmin();
      
      // Admins can update anything.
      // Receptionists and Waiters can only update specific fields for their workflows.
      allow update: if isAdmin() || 
                      ((isReceptionist() || isWaiter()) && request.resource.data.keys().hasOnly(['status', 'customerName', 'reservationId']));
    }
  }
}
