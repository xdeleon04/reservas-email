rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOneOfRoles(roles) {
      return request.auth.uid != null && request.auth.token.role in roles;
    }

    function isOwner(email) {
      return request.auth.uid != null && request.auth.token.email == email;
    }

    match /reservations/{reservationId} {
      // Anyone can create a reservation.
      allow create: if true;

      // Admins/receptionists can read all. Waiters can read confirmed/seated ones.
      // A signed-in user can read their own reservations.
      allow read: if isOneOfRoles(['admin', 'receptionist']) ||
                     (isOneOfRoles(['waiter']) && resource.data.status in ['Confirmed', 'Seated']) ||
                     isOwner(resource.data.email);

      // Only admins/receptionists can modify reservations.
      allow update, delete: if isOneOfRoles(['admin', 'receptionist']);
    }

    match /tables/{tableId} {
      // All staff can read tables.
      allow read: if isOneOfRoles(['admin', 'receptionist', 'waiter']);

      // Only admins can create or delete tables.
      allow create, delete: if isOneOfRoles(['admin']);
      
      // All staff can update tables (e.g., status). UI restricts specific actions.
      allow update: if isOneOfRoles(['admin', 'receptionist', 'waiter']);
    }
  }
}
