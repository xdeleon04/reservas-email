rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
        return isAuth() && request.auth.token.role == 'admin';
    }

    function isReceptionist() {
        return isAuth() && request.auth.token.role == 'receptionist';
    }

    // Collection Rules
    match /reservations/{reservationId} {
      // Any authenticated user can create a reservation for themselves.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;

      // Admins and Receptionists can read all reservations for the admin panel.
      allow read: if isAdmin() || isReceptionist();

      // Updates and deletes are only allowed via server actions, so deny direct client access.
      allow update, delete: if false;
    }

    match /tables/{tableId} {
      // Any authenticated staff member can view tables.
      allow read: if isAuth() && request.auth.token.role != null;
      
      // Only Admins can create/update/delete tables directly.
      // Other roles use server actions.
      allow create, update, delete: if isAdmin();
    }
    
    match /users/{userId} {
      // An admin can read any user, a user can read their own record.
      allow read: if isAuth() && (isAdmin() || request.auth.uid == userId);
      // Only admins can modify user roles.
      allow write: if isAdmin();
    }
  }
}
