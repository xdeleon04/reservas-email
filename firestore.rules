
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isSignedIn() && request.auth.token.role in ['admin', 'receptionist', 'waiter'];
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isReceptionist() {
        return isSignedIn() && request.auth.token.role == 'receptionist';
    }

    function isWaiter() {
        return isSignedIn() && request.auth.token.role == 'waiter';
    }
    
    function isAdminOrReceptionist() {
      return isAdmin() || isReceptionist();
    }

    // Reservations
    match /reservations/{reservationId} {
      // Allow anonymous users to create reservations
      allow create: if request.resource.data.email == request.auth.token.email || request.auth.token.email == null;

      // Allow admins and receptionists to read/write all reservations
      allow read, update, delete: if isAdminOrReceptionist();
      
      // Allow waiters to read reservations that are Confirmed or Seated for their queries.
      // Note: This rule is broad for list queries. More specific access is handled by the UI.
      allow read: if isWaiter();
      
      // Allow any authenticated user to read their own reservations
      allow read: if isSignedIn() && resource.data.email == request.auth.token.email;
    }
    
    // Tables
    match /tables/{tableId} {
      // Allow any staff member to read table data
      allow read: if isStaff();
      
      // Allow admins to create/delete tables
      allow create, delete: if isAdmin();
      
      // Allow admins to update all fields.
      // Allow receptionists & waiters to only update the 'status' field.
      allow update: if isAdmin() || 
                     ((isReceptionist() || isWaiter()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }
    
    // Users collection - no client access
    match /users/{userId} {
      allow read, write: if false;
    }
  }
}
