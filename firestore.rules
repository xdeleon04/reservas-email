
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isStaff() {
      return request.auth.token.role in ['admin', 'receptionist', 'waiter'];
    }
    
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }
    
    function isReceptionist() {
      return request.auth.token.role == 'receptionist';
    }
    
    function isWaiter() {
      return request.auth.token.role == 'waiter';
    }

    match /reservations/{reservationId} {
      // Allow authenticated users (including anonymous) to create reservations.
      allow create: if request.auth != null;

      // Admins and Receptionists can read all reservations.
      // Waiters can read reservations that are in an active or recently-completed state
      // to prevent snapshot listeners from breaking when status changes.
      allow read: if isAdmin() || isReceptionist() || 
                     (isWaiter() && resource.data.status in ['Confirmed', 'Seated', 'Completed', 'Cancelled']);

      // Admins and Receptionists can update reservations.
      // Waiters can only mark a 'Seated' reservation as 'Completed' and can only change the status.
      allow update: if isAdmin() || isReceptionist() || 
                       (
                         isWaiter() && 
                         request.resource.data.status == 'Completed' &&
                         resource.data.status == 'Seated' &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                       );
                       
      // Only admins can delete.
      allow delete: if isAdmin();
    }

    match /tables/{tableId} {
      // All staff members can read tables.
      allow read: if isStaff();

      // Only admins can create and delete tables.
      allow create, delete: if isAdmin();
      
      // Admins can update anything.
      // Receptionists/Waiters can only update the 'status' field.
      allow update: if isAdmin() ||
                       (
                         (isReceptionist() || isWaiter()) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                       );
    }
  }
}
