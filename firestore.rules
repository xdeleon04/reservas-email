
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for auth checks
    function isAuth() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    
    function getRole() {
      return request.auth.token.role;
    }
    
    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }
    
    function isReceptionist() {
      return isAuth() && getRole() == 'receptionist';
    }
    
    function isWaiter() {
      return isAuth() && getRole() == 'waiter';
    }
    
    match /reservations/{reservationId} {
      // ANY authenticated user (including anonymous) can create a reservation.
      allow create: if isAuth();

      // Admins and Receptionists can read and delete ANY reservation.
      allow read, delete: if isAdmin() || isReceptionist();
      
      // A user can read their own reservation document.
      // Used on the confirmation page after booking.
      allow read: if isUser(resource.data.userId);
      
      // Allow Admins and Receptionists to update any reservation.
      allow update: if isAdmin() || isReceptionist();
    }

    match /tables/{tableId} {
      // Admins can do anything with tables.
      allow write, delete: if isAdmin();
      
      // All staff can read all tables.
      allow read: if isAdmin() || isReceptionist() || isWaiter();
      
      // Allow receptionists and waiters to update only specific fields for specific status transitions.
      allow update: if (isAdmin() || isReceptionist() || isWaiter()) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'customerName', 'reservationId']);
    }
  }
}
