rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuth() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    function isReceptionist() {
      return isAuth() && getUserRole() == 'receptionist';
    }

    function isWaiter() {
        return isAuth() && getUserRole() == 'waiter';
    }
    
    function isStaff() {
        return isAdmin() || isReceptionist() || isWaiter();
    }

    match /reservations/{reservationId} {
      allow read: if isAuth() && (isAdmin() || isReceptionist() || request.auth.uid == resource.data.userId);
      allow list: if isAdmin() || isReceptionist();
      allow create: if isAuth();
      allow update, delete: if isAdmin() || isReceptionist();
    }

    match /tables/{tableId} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      // Let client-side logic handle specific status transitions
      allow update: if isStaff();
    }
  }
}
