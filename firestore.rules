rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isStaff() {
      return request.auth.token.role in ['admin', 'receptionist', 'waiter'];
    }
    
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }
    
    function isReceptionist() {
      return request.auth.token.role == 'receptionist';
    }

    function isWaiter() {
        return request.auth.token.role == 'waiter';
    }
    
    // Check that only allowed fields are being modified.
    // In our case, only 'status' can be updated by non-admins.
    function isUpdatingStatusOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /reservations/{reservationId} {
      allow create: if true;
      // Staff can read reservations. Waiters will be limited by the client-side query.
      // This is necessary because security rules for `list` operations cannot inspect document fields.
      allow read: if isStaff();
      // Admin and Receptionist can update/delete reservations.
      allow update, delete: if isAdmin() || isReceptionist();
    }
    
    match /tables/{tableId} {
      allow create, delete: if isAdmin();
      allow read: if isStaff();
      
      // Admin can update anything.
      // Receptionist/Waiter can only update the 'status' field to specific values.
      allow update: if isAdmin() ||
                      (isReceptionist() && isUpdatingStatusOnly() && request.resource.data.status in ['Reserved', 'Occupied', 'Available', 'Cleaning']) ||
                      (isWaiter() && isUpdatingStatusOnly() && request.resource.data.status in ['Cleaning', 'Available']);
    }
  }
}
