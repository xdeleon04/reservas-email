rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isStaff() {
        return request.auth != null && request.auth.token.role in ['admin', 'receptionist', 'waiter', 'cashier'];
    }
    function isAdmin() {
        return request.auth != null && request.auth.token.role == 'admin';
    }

    // Reservations:
    // - Customers (anonymous users) can create their own reservation.
    // - Customers can read reservations linked to their anonymous UID.
    // - All staff can read all reservations.
    // - All writes are handled by secure server actions.
    match /reservations/{reservationId} {
      allow create: if request.auth.token.firebase.sign_in_provider == 'anonymous' && request.resource.data.userId == request.auth.uid;
      allow read: if isStaff() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow update, delete: if false; // Deny all direct client writes for security
    }

    // Tables:
    // - Only Admins can create, update, or delete tables directly.
    // - All staff members can read tables.
    match /tables/{tableId} {
        allow read: if isStaff();
        allow create, update, delete: if isAdmin();
    }

    // Users collection is not directly managed by Firestore rules.
    // Role management is handled via secure server actions with the Admin SDK.
  }
}
