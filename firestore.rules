rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isStaff() {
      return request.auth.token.role in ['admin', 'receptionist', 'waiter'];
    }
    
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isReceptionist() {
      return request.auth.token.role == 'receptionist';
    }

    match /reservations/{reservationId} {
      // Let anyone create a reservation.
      allow create: if true;
      
      // Only admins and receptionists can read, update, or delete reservations directly.
      // Waiters interact with reservations via secure server actions.
      allow read, update, delete: if isAdmin() || isReceptionist();
    }
    
    match /tables/{tableId} {
      // Any staff member can read the table list.
      allow read: if isStaff();
      
      // Only Admins can create or delete tables.
      allow create, delete: if isAdmin();
      
      // Only admins can update tables directly from the client.
      // Other roles (receptionist, waiter) MUST use the secure server actions.
      allow update: if isAdmin();
    }
  }
}
