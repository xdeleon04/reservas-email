
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isRole(role) {
      return request.auth.token.role == role;
    }
    function isOneOfRoles(roles) {
      return request.auth.token.role in roles;
    }

    // Reservations: Public can create, staff can read/update, admin can delete
    match /reservations/{reservationId} {
      allow read: if isOneOfRoles(['admin', 'receptionist']);
      allow create: if request.auth != null; // Anyone authenticated (including anonymous)
      allow update: if isOneOfRoles(['admin', 'receptionist']);
      allow delete: if isRole('admin');
    }

    // Tables: Staff can read/update. Admin can CRUD.
    match /tables/{tableId} {
      allow read: if isOneOfRoles(['admin', 'receptionist', 'waiter', 'cashier']);
      allow create, delete: if isRole('admin');
      // Cashiers can update table status via payments, other staff can update for seating/cleaning
      allow update: if isOneOfRoles(['admin', 'receptionist', 'waiter', 'cashier']);
    }

    // MenuItems: Admins can manage the menu. All staff can read it.
    match /menuItems/{menuItemId} {
        allow read: if isOneOfRoles(['admin', 'receptionist', 'waiter', 'cashier']);
        allow create, update, delete: if isRole('admin');
    }

    // Orders: Staff can create/update orders. Cashiers can also update for payments. Admins have full access.
    match /orders/{orderId} {
      allow read: if isOneOfRoles(['admin', 'receptionist', 'waiter', 'cashier']);
      allow create, update: if isOneOfRoles(['admin', 'receptionist', 'waiter', 'cashier']);
      allow delete: if isRole('admin');
    }

    // Users collection should only be managed by server-side actions.
    match /users/{userId} {
        allow read, write: if false;
    }
  }
}
