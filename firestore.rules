
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Allow access for a specific admin email
      return request.auth.token.email == 'admin@example.com';
    }

    match /reservations/{reservationId} {
      // Any authenticated user (including anonymous) can create a reservation.
      allow create: if request.auth.uid != null;
      
      // Any authenticated user can read reservations, needed for email lookup.
      // Admin can also read.
      allow read: if request.auth.uid != null || isAdmin();
      
      // Only admin can update or delete reservations.
      allow update, delete: if isAdmin();
    }
    
    match /tables/{tableId} {
        // Only admin can manage tables.
        allow read, write: if isAdmin();
    }
  }
}
