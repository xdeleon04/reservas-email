
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // In a production app, use custom claims for security.
      // For this example, we identify the admin by their email.
      return request.auth.token.email == 'admin@example.com';
    }

    // Rules for the 'reservations' collection
    match /reservations/{reservationId} {
      // Admins can perform any action on any reservation.
      allow read, write: if isAdmin();
      
      // Authenticated (including anonymous) users can create their own reservations.
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      
      // Users can only read their own reservations.
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Rules for the 'tables' collection
    match /tables/{tableId} {
      // Only admins can read or write tables.
      allow read, write: if isAdmin();
    }
  }
}
